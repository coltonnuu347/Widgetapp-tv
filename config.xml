<?xml version="1.0" encoding="UTF-8"?>
<widget xmlns="http://www.w3.org/ns/widgets" xmlns:tizen="http://tizen.org/ns/widgets" id="http://tvdashboard.local/TVDashboard" version="1.0.0" viewmodes="maximized">
    <tizen:application id="TVDashBrd1.TVDashboard" package="TVDashBrd1" required_version="2.3"/>
    <content src="index.html"/>
    <feature name="http://tizen.org/feature/screen.size.normal.1080.1920"/>
    <icon src="icon.png"/>
    <name>Dashboard</name>
    <tizen:profile name="tv-samsung"/>
    <tizen:privilege name="http://tizen.org/privilege/internet"/>
    <tizen:privilege name="http://tizen.org/privilege/tv.inputdevice"/>
    <tizen:setting screen-orientation="landscape" context-menu="disable" background-support="disable" encryption="disable" install-location="auto" hwkey-event="enable"/>

    <!-- Network access. Every host the app talks to must be listed here. -->
    <access origin="https://icloud.com" subdomains="true"/>
    <access origin="https://workers.dev" subdomains="true"/>
    <access origin="https://open-meteo.com" subdomains="true"/>
    <access origin="https://weather.gov" subdomains="true"/>
    <access origin="https://ipapi.co" subdomains="true"/>
    <access origin="https://geojs.io" subdomains="true"/>
    <access origin="https://nager.at" subdomains="true"/>
    <access origin="https://nasa.gov" subdomains="true"/>
    <access origin="https://mapbox.com" subdomains="true"/>
    <access origin="https://spotify.com" subdomains="true"/>
    <access origin="https://scdn.co" subdomains="true"/>
    <access origin="https://spotifycdn.com" subdomains="true"/>
</widget>
